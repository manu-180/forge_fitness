# --- URL pública del sitio (Open Graph / metadata) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Marca (white-label: un proyecto Vercel por cliente) ---
# NEXT_PUBLIC_BRAND_NAME=Forge Fitness
# NEXT_PUBLIC_BRAND_WORD_PRIMARY=FORGE
# NEXT_PUBLIC_BRAND_WORD_SECONDARY=FITNESS
# Texto compacto en la barra de navegación
# NEXT_PUBLIC_BRAND_NAV_SHORT=FORGE
# Letra dentro del hexágono (logo tipográfico)
# NEXT_PUBLIC_BRAND_LOGO_LETTER=F
# Párrafo bajo el logo en el footer
# NEXT_PUBLIC_BRAND_TAGLINE_SHORT=Gym boutique premium en Buenos Aires. Entrenamiento de élite, comunidad real, resultados medibles.
# Sin @
# NEXT_PUBLIC_INSTAGRAM_HANDLE=forgefitness
# NEXT_PUBLIC_LOCATION_LABEL=Buenos Aires, ARG

# --- SEO ---
# NEXT_PUBLIC_SEO_TITLE=Forge Fitness — Gym Boutique Premium en Buenos Aires
# NEXT_PUBLIC_SEO_DESCRIPTION=Entrenamiento de élite en Buenos Aires...
# NEXT_PUBLIC_SEO_SITE_NAME=Forge Fitness
# Lista separada por comas (metadata keywords)
# NEXT_PUBLIC_SEO_KEYWORDS=gym, Buenos Aires, fitness, CrossFit
# Ruta bajo el sitio o URL absoluta (Open Graph / Twitter card)
# NEXT_PUBLIC_SEO_OG_IMAGE_URL=/og.png
# true = no indexar (demo / staging)
# NEXT_PUBLIC_SEO_NO_INDEX=false

# --- Contacto (footer) ---
# Multilínea: usar \n en el valor si tu entorno lo permite, o definir en NEXT_PUBLIC_SITE_CONFIG
# NEXT_PUBLIC_CONTACT_ADDRESS=Av. del Libertador 4980\nPalermo, Buenos Aires
# NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=11 2484-2720
# NEXT_PUBLIC_CONTACT_EMAIL=info@forgefitness.com
# Texto mostrado si difiere del mail real (opcional)
# NEXT_PUBLIC_CONTACT_EMAIL_DISPLAY=info@forgefitness.com
# Fallback si no definís NEXT_PUBLIC_WHATSAPP_PHONE (solo dígitos, sin +)
# NEXT_PUBLIC_CONTACT_WHATSAPP_DIGITS=5491124842720
# NEXT_PUBLIC_CONTACT_HOURS=Lun-Vie: 6:00–22:00\nSáb: 8:00–14:00
# Búsqueda en Google Maps
# NEXT_PUBLIC_MAPS_SEARCH_QUERY=Av. del Libertador 4980, Palermo, Buenos Aires, Argentina

# --- Hero ---
# NEXT_PUBLIC_HERO_EYEBROW_LEFT=Est. 2024 — Buenos Aires
# NEXT_PUBLIC_HERO_EYEBROW_RIGHT=No Pain, No Gain
# NEXT_PUBLIC_HERO_CATEGORY_LINE=Gym Boutique Premium — Buenos Aires
# NEXT_PUBLIC_HERO_TITLE_LINE_1=FORGE
# NEXT_PUBLIC_HERO_TITLE_LINE_2=YOUR BODY
# NEXT_PUBLIC_HERO_SUBTITLE=Entrenamiento de élite en un espacio diseñado...

# --- Preloader ---
# NEXT_PUBLIC_PRELOADER_SUBLINE=Forjá tu mejor versión

# --- Assets ---
# Logo en navbar/footer (bajo /public) y favicon
# NEXT_PUBLIC_ASSETS_LOGO_IMAGE=/logo-onfit.png
# NEXT_PUBLIC_ASSETS_FAVICON_PATH=/logo-onfit.png

# --- Secciones / flags avanzados (JSON merge sobre defaults) ---
# Opcional: un solo JSON con overrides parciales (marca, seo, contact, hero, preloader, sections).
# Claves válidas en sections: preloader, tickerMotivation, differentiators, tickerCategories,
# programs, coaches, schedule, pricing, testimonials, tickerReviews, tickerBadges, experience, gallery, cta
# Ejemplo mínimo:
# NEXT_PUBLIC_SITE_CONFIG={"sections":{"gallery":false,"testimonials":false}}
# También podés incluir p.ej. "seo":{"indexable":false,"keywords":"..."} o "contact":{"whatsappPhoneDigits":"549..."}

# WhatsApp (solo dígitos, sin +)
# NEXT_PUBLIC_WHATSAPP_PHONE=5491124842720

# Opcional: URL del MP4 del hero
# NEXT_PUBLIC_HERO_VIDEO_URL=https://cdn.coverr.co/videos/coverr-a-man-working-out-1749/1080p.mp4

# Redes (footer); si no están definidas, el enlace queda en "#"
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/tu_usuario
# NEXT_PUBLIC_X_URL=https://x.com/tu_usuario
# NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@tu_usuario
